{
  "version": 2,
  "extension": {
    "osis_configuration_metadata": {
      "builder_type": "visual"
    }
  },
  "vectoringestion10mfaiss16x": {
    "source": {
      "s3": {
        "acknowledgments": true,
        "scan": {
          "buckets": [
            {
              "bucket": {
                "name": "opensearch-book-handson-data-153766774185",
                "filter": {
                  "include_prefix": [
                    "synthetic-cohere-like-parquet-10m-v2/data/"
                  ]
                }
              }
            }
          ]
        },
        "aws": {
          "region": "__AWS_REGION__",
          "sts_role_arn": "__INGESTION_ROLE_ARN__"
        },
        "codec": {
          "parquet": null
        },
        "compression": "none",
        "workers": "5"
      }
    },
    "processor": [
      {
        "rename_keys": {
          "entries": [
            {
              "from_key": "_id",
              "to_key": "id"
            },
            {
              "from_key": "text",
              "to_key": "chunk"
            }
          ]
        }
      },
      {
        "list_to_map": {
          "source": "vector",
          "use_source_key": true,
          "extract_value": true
        }
      },
      {
        "delete_entries": {
          "with_keys": [
            "vector"
          ]
        }
      },
      {
        "rename_keys": {
          "entries": [
            {
              "from_key": "element",
              "to_key": "vector"
            }
          ]
        }
      }
    ],
    "sink": [
      {
        "opensearch": {
          "hosts": [
            "__DOMAIN_ENDPOINT__"
          ],
          "aws": {
            "serverless": false,
            "region": "__AWS_REGION__",
            "sts_role_arn": "__INGESTION_ROLE_ARN__"
          },
          "index_type": "custom",
          "index": "synthetic_10m_faiss_16x",
          "template_type": "index-template",
          "template_content": "{\"template\":{\"settings\":{\"knn\":true,\"refresh_interval\":\"300s\",\"number_of_shards\":1,\"number_of_replicas\":0,\"index.knn.advanced.approximate_threshold\":100000,\"index.knn.remote_index_build.enabled\":true,\"index.knn.remote_index_build.size.min\":\"5mb\",\"index.knn.algo_param.ef_search\":128},\"mappings\":{\"properties\":{\"vector\":{\"type\":\"knn_vector\",\"dimension\":1024,\"method\":{\"name\":\"hnsw\",\"space_type\":\"cosinesimil\",\"engine\":\"faiss\",\"parameters\":{\"ef_construction\":128,\"m\":16}},\"compression_level\":\"16x\",\"mode\":\"on_disk\"},\"id\":{\"type\":\"keyword\"},\"url\":{\"type\":\"keyword\"},\"title\":{\"type\":\"text\"},\"chunk\":{\"type\":\"text\"}}}}}"
        }
      }
    ]
  }
}
